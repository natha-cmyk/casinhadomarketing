# Copie para .env e preencha.
# Supabase → Project Settings → Database → Connection string:
#   DATABASE_URL = "Transaction pooler" (host ...pooler..., porta 6543) + "?pgbouncer=true"
#   DIRECT_URL   = "Session/Direct" (porta 5432) — usada por prisma migrate
# Postgres simples (local/EasyPanel): aponte os dois para a mesma URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Integrações futuras (etapa pós dia-1 — ver INTEGRACOES.md)
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
OPENCLAW_URL=
OPENCLAW_TOKEN=
