# Copie para .env e preencha.

# ── Postgres (Supabase: pooler 6543 + direct 5432 para migrate) ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Auth (Supabase) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Zernio (server-only) ──
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=

# ── Stripe (billing) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_ANUAL_PARCELADO=
STRIPE_PRICE_ANUAL_AVISTA=

# ── LLM agência (fallback; clientes usam BYO em LlmConfig) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── E-mail ──
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=
NEXT_PUBLIC_APP_URL=

# ── Operação ──
CRON_SECRET=
ADMIN_EMAILS=
SEAHUB_EMAILS=
