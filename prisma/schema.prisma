// schema.prisma — Casinha do Marketing (Seahub) · MULTI-TENANT
// Supabase Postgres. Auth pelo Supabase (auth.users). Aqui espelhamos o User por id (uuid)
// e escopamos TUDO por workspaceId. Cada workspace = um profile na Zernio (zernioProfileId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth / Tenancy
// ─────────────────────────────────────────────────────────────
model User {
  id          String       @id // = auth.users.id (uuid do Supabase)
  email       String       @unique
  nome        String       @default("")
  createdAt   DateTime     @default(now())
  lastSeenAt  DateTime? // último acesso (atualizado com throttle de 10min p/ o Admin)
  memberships Membership[]
}

model Workspace {
  id              String        @id @default(cuid())
  nome            String
  zernioProfileId String? // profile da Zernio (contas conectadas deste workspace)
  onboarded       Boolean       @default(false) // já passou pelo onboarding de 1º acesso?
  createdAt       DateTime      @default(now())
  memberships     Membership[]
  envConfig       EnvConfig?
  perfil          Perfil?
  objetivo        Objetivo?
  posts           Post[]
  areas           Area[]
  personas        Persona[]
  concorrentes    Concorrente[]
  fontes          Fonte[]
  crmConfig       CrmConfig?
  leads           Lead[]
  historico       HistoricalMetric[]
  llmConfig       LlmConfig?
  events          Event[]
  profiles        WorkspaceProfile[]
}

// ─────────────────────────────────────────────────────────────
// Profiles da integração por workspace. A integração limita 1 conta por rede por
// PROFILE — então multi-conta (2+ Instagrams) exige VÁRIOS profiles no mesmo workspace.
// zernioProfileId do Workspace = profile primário; os extras ficam aqui. As leituras
// (listar contas) agregam todos; conectar uma 2ª conta da mesma rede cria um novo profile.
// ─────────────────────────────────────────────────────────────
model WorkspaceProfile {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  zernioProfileId String    @unique
  label           String    @default("")
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// Audit log — rastreio de eventos (quem fez o quê). Ex.: publicou post,
// completou onboarding, conectou LLM/CRM/conta. Exibido no Admin.
// ─────────────────────────────────────────────────────────────
model Event {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       String    @default("") // e-mail de quem fez a ação
  type        String // ex.: post.published, onboarding.completed, llm.connected
  target      String    @default("") // ex.: título do post, plataforma
  meta        Json      @default("{}")
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// LLM por workspace (BYO-LLM): cada empresa conecta a PRÓPRIA fonte de LLM
// (OpenRouter/Anthropic). Os agentes rodam com essa chave; sem ela, modo chatbot mínimo.
// A chave da agência (env) é só fallback de teste.
// ─────────────────────────────────────────────────────────────
model LlmConfig {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String    @default("openrouter") // openrouter | anthropic
  apiKey      String // TODO(segurança): cifrar em repouso
  model       String    @default("") // slug opcional; default por provider
  updatedAt   DateTime  @updatedAt
}

enum Role {
  owner
  member
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(member)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// Configuração do ambiente (1 por workspace)
// ─────────────────────────────────────────────────────────────
model EnvConfig {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  redes       Json      @default("{}") // { redeId: bool }
  paineis     Json      @default("{}") // { painel: { indId: bool } }
  contas      Json      @default("{}") // { redeId: { on, accountId } } — contas Zernio conectadas
  cfgOpen     Json      @default("{}")
  impOpen     Boolean   @default(false)
  adConfig    Json      @default("{}") // { manualChannels: [...], adAccounts: {…} } — mídia paga
  customInd   Json      @default("{}") // { painel: [ {id,label,metric,...} ] } — indicadores criados pelo perfil
  calManuais  Json      @default("[]") // ["WhatsApp (grupos)", ...] — canais MANUAIS do calendário (só registro, sem publicação síncrona)
  agentsConfig Json     @default("{}") // { agentKey: { enabled, panels:[]|null, promptExtra } } — personalização dos agentes
  widgetLayout Json     @default("{}") // { painel: { order:[], size:{id:"sm"|"lg"}, hidden:[] } } — layout arrastável/redimensionável dos widgets
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Perfil / Ambiente (1 por workspace)
// ─────────────────────────────────────────────────────────────
model Perfil {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  empresa     String    @default("")
  segmento    String    @default("")
  ramo        String    @default("") // ramo de atividade (onboarding)
  telefone    String    @default("") // telefone principal de contato
  emailContato String   @default("") // e-mail principal de contato
  cidade      String    @default("")
  estado      String    @default("") // UF (onboarding: cidade + estado, sem endereço específico)
  site        String    @default("")
  canais      String[]  @default([])
  produtos    String[]  @default([])
  relacao     Json      @default("{}")
  kitArquivo  String?
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Calendário de conteúdo
// ─────────────────────────────────────────────────────────────
enum PostStatus {
  rascunho
  agendado
  publicado
  falhou
}

model Post {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  data         DateTime
  hora         String     @default("09:00")
  titulo       String
  canal        String
  perfil       String
  colab        String     @default("")
  pilar        String     @default("")
  formato      String     @default("")
  funil        String     @default("")
  legenda      String     @default("")
  cta          String     @default("")
  hashtags     String     @default("")
  arquivo      String     @default("")
  // mídia enviada (presign Zernio): [{ type, url, filename, mimeType, size? }]
  media        Json       @default("[]")
  status       PostStatus @default(rascunho)
  contas       String[]   @default([])
  zernioPostId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workspaceId, data])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Fontes de dados importadas
// ─────────────────────────────────────────────────────────────
enum FonteTipo {
  csv
  xlsx
  pdf
}

model Fonte {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nome        String
  tipo        FonteTipo
  campos      Int       @default(0)
  usados      Int       @default(0)
  linhas      Int       @default(0)
  pendente    Boolean   @default(false)
  camposMap   Json      @default("[]")
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// OKR / Metas
// ─────────────────────────────────────────────────────────────
model Objetivo {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  texto       String    @default("")
  updatedAt   DateTime  @updatedAt
}

model Area {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nome        String
  ordem       Int       @default(0)
  krs         KR[]

  @@index([workspaceId])
}

model KR {
  id        String  @id @default(cuid())
  areaId    String
  area      Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  kr        String  @default("")
  alvo      String  @default("")
  un        String  @default("")
  tag       String  @default("")
  resp      String  @default("")
  ordem     Int     @default(0)
  realizado String?

  @@index([areaId])
}

// ─────────────────────────────────────────────────────────────
// Personas
// ─────────────────────────────────────────────────────────────
model Persona {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tag         String
  handle      String    @default("")
  emoji       String    @default("")
  cover       String    @default("")
  nome        String
  representa  String    @default("")
  comunica    String    @default("")
  dores       String[]  @default([])
  canais      String    @default("")
  gatilho     String    @default("")
  stats       Json      @default("[]")
  foto        String?
  // persona como pessoa real: { nomeProprio, consome[], gosta[], naoGosta[], atividades[] }
  detalhes    Json      @default("{}")
  ordem       Int       @default(0)

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// Concorrência
// ─────────────────────────────────────────────────────────────
enum CompCategoria {
  espaco
  marca
  certificado
  cobranca
}

model Concorrente {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nome         String
  ig           String        @default("")
  linkedin     Boolean       @default(false)
  youtube      Boolean       @default(false)
  dominio      String?
  categoria    CompCategoria
  iconOverride String?
  ordem        Int           @default(0)

  @@index([workspaceId, categoria])
}

// ─────────────────────────────────────────────────────────────
// CRM — Geração por Canais (leads/oportunidades). O CRM do cliente
// vive no ClickUp (fora da integração social). Dois modos de conexão:
// ClickUp nativo (API REST c/ token do usuário) ou webhook genérico.
// ─────────────────────────────────────────────────────────────
model CrmConfig {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider      String    @default("clickup") // "clickup" | "webhook"
  clickupToken  String? // TODO(segurança): cifrar clickupToken em repouso
  clickupListId String?
  fieldMap      Json      @default("{}") // { channel|product|status|value|lossReason : "<nome do campo no ClickUp>" }
  webhookSecret String?
  lastSyncAt    DateTime? // último sync bem-sucedido — sync incremental puxa só o que mudou desde então
  updatedAt     DateTime  @updatedAt
}

model Lead {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  extId       String? // id do lead no CRM (task.id no ClickUp)
  title       String?
  source      String? // "clickup" | "webhook"
  channel     String?
  product     String?
  status      String?
  stage       String?
  value       Float     @default(0)
  lossReason  String?
  createdAt   DateTime  @default(now())
  raw         Json      @default("{}")

  @@unique([workspaceId, extId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// Importador de histórico — totais mensais das planilhas antigas
// (pré-90 dias) que a integração ao vivo não puxa. Uma célula por
// (plataforma × métrica × ano × mês). Upsert por competência.
// TODO(historico): ligar HistoricalMetric nos painéis pra períodos fora dos 90 dias.
// ─────────────────────────────────────────────────────────────
model HistoricalMetric {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform    String // "instagram" | "meta_ads" | "leads" | "google_ads"
  metric      String
  ano         Int
  mes         Int // 1-12
  valor       Float     @default(0)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, platform, metric, ano, mes])
  @@index([workspaceId, platform])
}
