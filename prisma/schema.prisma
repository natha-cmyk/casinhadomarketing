// schema.prisma — Casinha do Marketing (Seahub)
// Postgres no EasyPanel. Singletons usam id fixo "main" (sempre upsert por esse id).
// Dados read-mostly (Instagram mensal, ADS, CANAIS, LEADS_M, MRR) ficam em lib/seed-data.ts,
// não em tabela — só o que o usuário edita é persistido aqui.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Configuração do ambiente (singleton id="main")
// ─────────────────────────────────────────────────────────────
model EnvConfig {
  id       String @id @default("main")
  redes    Json   @default("{\"instagram\":true}") // { redeId: bool } — quais redes/canais estão ativos
  paineis  Json   @default("{}")                   // { painel: { indicadorId: bool } } — visibilidade de indicadores
  contas   Json   @default("{\"instagram\":true}") // { redeId: bool } — contas conectadas p/ publish (social+conversas)
  cfgOpen  Json   @default("{}")                   // { painel: bool } — acordeões abertos (UI, opcional)
  impOpen  Boolean @default(false)                 // "Importe seus dados" aberto (UI, opcional)
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Perfil / Ambiente (singleton id="main")
// ─────────────────────────────────────────────────────────────
model Perfil {
  id         String   @id @default("main")
  empresa    String   @default("Seahub Coworking")
  segmento   String   @default("")
  cidade     String   @default("")
  site       String   @default("")
  canais     String[] @default([]) // canais trabalhados (chips)
  produtos   String[] @default([]) // produtos & serviços (chips)
  relacao    Json     @default("{}") // { "canal|produto": true } — matriz canais × produtos
  kitArquivo String?  // nome do PDF do kit do Panteão importado (extração no backend)
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Calendário de conteúdo
// ─────────────────────────────────────────────────────────────
enum PostStatus {
  rascunho
  agendado
  publicado
  falhou
}

model Post {
  id        String     @id @default(cuid())
  data      DateTime   // dia agendado/publicado (usar só a data)
  hora      String     @default("09:00") // "HH:MM"
  titulo    String
  canal     String     // Instagram | WhatsApp (grupos) | Lista de transmissão | Blog | ...
  perfil    String     // Seahub | Seabox | Hub Empreendedoras
  colab     String     @default("") // perfil colaborador (aparece nos dois perfis)
  pilar     String     @default("")
  formato   String     @default("")
  funil     String     @default("")
  legenda   String     @default("")
  cta       String     @default("")
  hashtags  String     @default("")
  arquivo   String     @default("") // nome do arquivo de capa/mídia
  status    PostStatus @default(rascunho)
  contas    String[]   @default([]) // redes-alvo p/ publicar (ids de rede conectada)
  // futuro (Zernio): zernioPostId, scheduledFor, publishedAt, errorMsg
  zernioPostId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([data])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Fontes de dados importadas (Personalização → Importe seus dados)
// ─────────────────────────────────────────────────────────────
enum FonteTipo {
  csv
  xlsx
  pdf
}

model Fonte {
  id        String    @id @default(cuid())
  nome      String
  tipo      FonteTipo
  campos    Int       @default(0) // nº de campos detectados
  usados    Int       @default(0) // nº de campos escolhidos
  linhas    Int       @default(0)
  pendente  Boolean   @default(false) // xlsx/pdf: interpretação no backend/OpenClaw
  camposMap Json      @default("[]")  // opcional: [{nome,tipo,usar}] do CSV
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// OKR / Metas
// ─────────────────────────────────────────────────────────────
model Objetivo {
  id    String @id @default("main")
  texto String @default("")
  updatedAt DateTime @updatedAt
}

model Area {
  id    String @id @default(cuid())
  nome  String
  ordem Int    @default(0)
  krs   KR[]
}

model KR {
  id     String @id @default(cuid())
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  kr     String @default("")
  alvo   String @default("")
  un     String @default("")
  tag    String @default("")
  resp   String @default("")
  ordem  Int    @default(0)
  // futuro (acompanhamento mensal): realizado, progresso
  realizado String?

  @@index([areaId])
}

// ─────────────────────────────────────────────────────────────
// Personas (Persona & Público)
// ─────────────────────────────────────────────────────────────
model Persona {
  id        String   @id @default(cuid())
  tag       String   // "P0 · Marca", "P1 · Endereço Fiscal", ...
  handle    String   @default("")
  emoji     String   @default("")
  cover     String   @default("") // css gradient
  nome      String
  representa String  @default("")
  comunica  String   @default("")
  dores     String[] @default([])
  canais    String   @default("")
  gatilho   String   @default("")
  stats     Json     @default("[]") // [[valor, rótulo], ...]
  foto      String?  // URL configurável (fallback = emoji)
  ordem     Int      @default(0)
}

// ─────────────────────────────────────────────────────────────
// Concorrência
// ─────────────────────────────────────────────────────────────
enum CompCategoria {
  espaco      // Espaço & EV
  marca       // Registro de Marca
  certificado // Certificado Digital
  cobranca    // Cobrança
}

model Concorrente {
  id           String        @id @default(cuid())
  nome         String
  ig           String        @default("") // @handle
  linkedin     Boolean       @default(false)
  youtube      Boolean       @default(false)
  dominio      String?       // p/ logo (Clearbit) e link do site
  categoria    CompCategoria
  iconOverride String?       // URL, emoji, ou "IG:<handle>" (puxar do Instagram)
  ordem        Int           @default(0)

  @@index([categoria])
}
